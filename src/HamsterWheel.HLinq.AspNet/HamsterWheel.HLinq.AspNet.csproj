<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <OutputType>Library</OutputType>
        <RootNamespace>HamsterWheel.HLinq.AspNet</RootNamespace>
        <IsPackable>true</IsPackable>
        <Description>ASP.NET Core integration for HLinq: ConfigureHLinq() wires the binder into the host, reads the query off the request and answers with the warnings the binder reported.</Description>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\HamsterWheel.HLinq\HamsterWheel.HLinq.csproj" />
    </ItemGroup>

</Project>
