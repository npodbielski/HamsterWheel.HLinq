<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
        <Description>Query your API through its query string - where, select, orderBy, groupBy, skip and take are translated to LINQ and applied to an IQueryable of your choice: an EF context against a database engine, or an in-memory collection. There are also extensions for ASP.NET Core, a client package, and function packs per database engine.</Description>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
        <DefineConstants>TRACE;HLINQ</DefineConstants>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
        <DefineConstants>TRACE;HLINQ</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\HamsterWheel.HLinq.Abstractions\HamsterWheel.HLinq.Abstractions.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="DynamicAnonymousType" />
        <PackageReference Include="HamsterWheel.CodeShare.NetStandard" />
        <PackageReference Include="Microsoft.AspNetCore.Http.Abstractions" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
        <PackageReference Include="System.Text.Json"  />
    </ItemGroup>
    
    <ItemGroup Condition=" '$(TargetFramework)' == 'net10.0' ">
        <Compile Remove="**\*.NetStandard.cs" />
        <Compile Update="Pipeline\Tokenizer\Grammar.Exceptions.cs">
          <DependentUpon>Grammar.cs</DependentUpon>
        </Compile>
        <Compile Update="Pipeline\Tokenizer\HLinqTokenizer.Exceptions.cs">
          <DependentUpon>HLinqTokenizer.cs</DependentUpon>
        </Compile>
        <Compile Update="Pipeline\Tokenizer\HLinqTokenizer.Net100.cs">
          <DependentUpon>HLinqTokenizer.cs</DependentUpon>
        </Compile>
        <Compile Update="Pipeline\Tokenizer\HLinqTokenizer.Language.cs">
          <DependentUpon>HLinqTokenizer.cs</DependentUpon>
        </Compile>
        <Compile Update="Pipeline\Tokenizer\HLinqTokenizer.WordTranslation.cs">
          <DependentUpon>HLinqTokenizer.cs</DependentUpon>
        </Compile>
        <Compile Update="Tree\Filtering\AggregateMethodToExpressionConverter.Exceptions.cs">
          <DependentUpon>AggregateMethodToExpressionConverter.cs</DependentUpon>
        </Compile>
        <Compile Update="Tokens\TokenBase.Net100.cs">
          <DependentUpon>TokenBase.cs</DependentUpon>
        </Compile>
        <Compile Update="ExtensionMethods\StringArrayExtensions.Net100.cs">
          <DependentUpon>StringArrayExtensions.cs</DependentUpon>
        </Compile>
        <Compile Update="ExtensionMethods\StringExtensions.Net100.cs">
          <DependentUpon>StringExtensions.cs</DependentUpon>
        </Compile>
        <Compile Update="Pipeline\Applier\Builders\ExpressionBuilder.Comparison.cs">
          <DependentUpon>ExpressionBuilder.cs</DependentUpon>
        </Compile>
        <Compile Update="Pipeline\Applier\Builders\ExpressionBuilder.Math.cs">
          <DependentUpon>ExpressionBuilder.cs</DependentUpon>
        </Compile>
        <Compile Update="Pipeline\Applier\Builders\ExpressionBuilder.Value.cs">
          <DependentUpon>ExpressionBuilder.cs</DependentUpon>
        </Compile>
    </ItemGroup>

    <ItemGroup Condition=" '$(TargetFramework)' == 'netstandard2.0' ">
        <Compile Remove="**\*.Net100.cs" />
        <Compile Update="ExtensionMethods\StringArrayExtensions.NetStandard.cs">
            <DependentUpon>StringArrayExtensions.cs</DependentUpon>
        </Compile>
        <Compile Update="ExtensionMethods\StringExtensions.NetStandard.cs">
            <DependentUpon>StringExtensions.cs</DependentUpon>
        </Compile>
        <Compile Update="Pipeline\Tokenizer\HLinqTokenizer.NetStandard.cs">
            <DependentUpon>HLinqTokenizer.cs</DependentUpon>
        </Compile>
        <Compile Update="Tokens\TokenBase.NetStandard.cs">
            <DependentUpon>TokenBase.cs</DependentUpon>
        </Compile>
    </ItemGroup>

    <ItemGroup>
        <Compile Update="Tree\Filter\Condition.Exceptions.cs">
            <DependentUpon>Condition.cs</DependentUpon>
        </Compile>
        <Compile Update="Tree\Paging\SkipRoot.Exceptions.cs">
            <DependentUpon>SkipRoot.cs</DependentUpon>
        </Compile>
        <Compile Update="Request\HLinqQuery.Exceptions.cs">
            <DependentUpon>HLinqQuery.cs</DependentUpon>
        </Compile>
        <Compile Update="Tree\Filtering\Condition.Exceptions.cs">
            <DependentUpon>Condition.cs</DependentUpon>
        </Compile>
        <Compile Update="Tree\Filtering\Method.Exceptions.cs">
            <DependentUpon>Method.cs</DependentUpon>
        </Compile>
        <Compile Update="Tree\Filtering\MethodSource.cs">
            <DependentUpon>Method.cs</DependentUpon>
        </Compile>
        <Compile Update="Tree\Filtering\PropertyMethodToExpressionConverter.cs">
            <DependentUpon>Method.cs</DependentUpon>
        </Compile>
        <Compile Update="Tree\Filtering\StaticMethodToExpressionConverter.cs">
            <DependentUpon>Method.cs</DependentUpon>
        </Compile>
        <Compile Update="Tree\Selecting\PropertyAssigment.Exceptions.cs">
            <DependentUpon>PropertyAssignment.cs</DependentUpon>
        </Compile>
    </ItemGroup>

</Project>
