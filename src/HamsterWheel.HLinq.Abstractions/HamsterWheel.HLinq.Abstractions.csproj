<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
        <Nullable>enable</Nullable>
        <LangVersion>13.0</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>HamsterWheel.HLinq</RootNamespace>
        <Description>The interfaces of HLinq - the query, the tree, the binder's contracts - without the implementation, to build extensions or to consume a bound query without pulling the binder in.</Description>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="System.Memory" />
    </ItemGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
      <DefineConstants>TRACE;HLINQ</DefineConstants>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
      <DefineConstants>TRACE;HLINQ</DefineConstants>
    </PropertyGroup>

</Project>
